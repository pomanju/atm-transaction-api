<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:email="http://www.mulesoft.org/schema/mule/email" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd">
	<sub-flow name="query-account-number-flow" doc:id="8f7a6996-b9c5-4acd-9e29-71ad85b94693" >
		<logger level="INFO" doc:name="Logger" doc:id="46c1775a-0eb0-438b-b8c8-d56873db7c24" message="#[payload]"/>
		<db:query-single doc:name="Query single" doc:id="853aab63-2ee9-49b1-ab3d-9ffe974db650" config-ref="Database_Config" target="accountQuery">
			<db:sql ><![CDATA[SELECT `pk`, `custName`, `custAccNum`, `atmPin`, `bankName`, `accountType`, `ifscCode`, `branchName`, `totalBalance`, `transactionTimeStamp`, `accountStatus`, `wrongPin`, `mailId`, `phoneNumber` FROM `Bank_Transactions1` where (`custAccNum`=:accnum and `bankName`=:bank)]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
	"accnum": vars.accountNum,
	"bank": vars.bank
}]]]></db:input-parameters>
		</db:query-single>
		<logger level="INFO" doc:name="Logger" doc:id="6936de15-2ca7-420a-9227-735f2dca4f3f" message="#[payload]"/>
	</sub-flow>
	<sub-flow name="send-email-subflow" doc:id="b217ec00-3fc7-4507-97d8-696880183f35" >
		<parse-template doc:name="Parse Template" doc:id="7df6a87e-cdd8-4167-987f-5adfdf55cf30" location="mail-template.html" />
		<email:send doc:name="Send email to user" doc:id="797a52a7-b59a-4ec3-ad11-a9666937f0cf" config-ref="Email_SMTP" fromAddress="pomanju4@gmail.com" subject='#[vars.mailSubject]' toAddresses='#[[if (vars.inputPayload.mailId != null and vars.inputPayload.mailId != "") vars.inputPayload.mailId else vars.accountQuery.mailId]]' >
			<email:body contentType="text/html" encoding="UTF-8" >
			</email:body>
		</email:send>
	</sub-flow>
	<sub-flow name="atmpin-invalid-subflow" doc:id="07e1c25c-a45e-4939-b5ff-5d35a217cfc5" >
		<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;(vars.accountQuery.wrongPin) as Number + 1]" doc:name="Set wrong pin count variable" doc:id="42c98849-a5e1-47a2-b24d-09f55609d858" variableName="wrongPinCount"/>
		<choice doc:name="Check woring pin count" doc:id="212d94fc-f638-4d57-ba89-4fce283e3ca9" >
			<when expression="#[(vars.wrongPinCount) &lt; 3]">
				<logger level="INFO" doc:name="Logger" doc:id="ccf86ef3-514e-4b6b-ab75-d3df19fa85f0" message="Before appending wrong atm pin count"/>
				<db:update doc:name="Update" doc:id="342f03d1-a220-46d0-9325-2fe4741e9d49" config-ref="Database_Config">
					<db:sql ><![CDATA[UPDATE `Bank_Transactions1` SET `wrongPin`= :wrongpin where `custAccNum`= :custAccNum]]></db:sql>
					<db:input-parameters ><![CDATA[#[{
	"wrongpin": vars.wrongPinCount,
	"custAccNum": vars.inputPayload.accountNum
}]]]></db:input-parameters>
				</db:update>
				<logger level="INFO" doc:name="Logger" doc:id="1ce3e9b6-f190-4d06-91df-3fe71d85272c" message="after increasing wrong pin count"/>
				<ee:transform doc:name="Transform Message1" doc:id="1b5ccecf-2a4d-470c-b972-9035a78b41c3">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="mailSubject"><![CDATA[%dw 2.0
output application/json
---
"Failed Attempt  !"]]></ee:set-variable>
						<ee:set-variable variableName="mailBody"><![CDATA[%dw 2.0
output application/json
---
"This is to inform you that there’s a failed attempt happened while transaction. Your Account will be blocked after 3 attempts"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="send-email-subflow" doc:id="931df9d3-51aa-4941-8684-5e0f9eed73ad" name="send-email-subflow"/>
				<ee:transform doc:name="Transform Message" doc:id="7786c641-5b1b-4f37-9f62-99e56fe8961d" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Login Attempt Failed. Attempts left : " ++ (3 - vars.wrongPinCount)]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="0cb8af24-a4b6-44a2-9023-91220f8b1264" message="Before blocking account" />
				<db:update doc:name="Update" doc:id="89a62cbf-e90d-4014-a962-e133dcce39ed" config-ref="Database_Config">
					<db:sql ><![CDATA[UPDATE `Bank_Transactions1` SET `accountStatus`= "Blocked" where `custAccNum`= :custAccNum]]></db:sql>
					<db:input-parameters ><![CDATA[#[{
	"custAccNum": vars.inputPayload.accountNum,
	"wrongPin": vars.wrongPinCount
}]]]></db:input-parameters>
				</db:update>
				<logger level="INFO" doc:name="Logger1" doc:id="1e86ee12-7e43-4e9c-825d-453f14275a8d" message="after blocking account"/>
				<ee:transform doc:name="Transform Message" doc:id="fe40e748-0a9a-4af7-bc76-5bbf5979ca58">
					<ee:message>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="mailSubject" ><![CDATA[%dw 2.0
output application/json
---
"Account Blocked  !"]]></ee:set-variable>
						<ee:set-variable variableName="mailBody" ><![CDATA[%dw 2.0
output application/json
---
"This is to inform you that Your Account has been be blocked due to 3 failed attempts. Please reach out nearest branch to unblock"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="send-email-subflow" doc:id="4cc80cd3-0438-4a3e-8c99-550673214069" name="send-email-subflow"/>
				<ee:transform doc:name="Transform Message" doc:id="e2559716-9de6-43a4-88bf-3c7c543c8b8f" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Maximum Attempts reached .Your Account " ++ vars.accountNum ++ " is temporarily blocked. Please reach nearest Branch"]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
